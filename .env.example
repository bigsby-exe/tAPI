# API Configuration
API_KEY=your-strong-secret-api-key-here

# Database Configuration
# For local Docker stack, these values are used by docker-compose.yml
POSTGRES_USER=tapi_user
POSTGRES_PASSWORD=tapi_password
POSTGRES_DB=tapi_db

# Database URL
# For local Docker stack, this will be automatically set by docker-compose
# For production, use your managed database connection string (e.g., Supabase)
DATABASE_URL=postgresql://tapi_user:tapi_password@db:5432/tapi_db
